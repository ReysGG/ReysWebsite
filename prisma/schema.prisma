generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  gifUrl      String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       String?
  features    String[]
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String
  content   String
  avatar    String?
  createdAt DateTime @default(now())
}

model Post {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  content          String
  excerpt          String?
  coverImage       String?
  ogImage          String?
  author           String?
  category         String?
  focusKeyword     String?
  canonicalUrl     String?
  published        Boolean   @default(false)
  featured         Boolean   @default(false)
  publishedAt      DateTime?
  metaTitle        String?
  metaDesc         String?
  tags             String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  views            Int       @default(0)
  readingTime      Int       @default(1)
  scheduledAt      DateTime?
  aiGenerated      Boolean   @default(false)
  coverImageCredit String?
  comments         Comment[]
  likes            Like[]

  @@index([published, scheduledAt])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  userId    String
  userImg   String?
  userName  String?
  postId    String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model Showcase {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  htmlUrl     String
  thumbnail   String?
  tags        String[]
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, order])
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum AiProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  OPENROUTER
  OPENAI_COMPATIBLE
}

model AiProvider {
  id           String         @id @default(cuid())
  name         String
  type         AiProviderType
  baseUrl      String?
  apiKeyEnc    String
  models       String[]
  defaultModel String
  imageModel   String?
  priority     Int            @default(0)
  enabled      Boolean        @default(true)
  lastError    String?
  lastErrorAt  DateTime?
  lastUsedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([enabled, priority])
}

enum AiScheduleMode {
  DRAFT
  PUBLISH
  SCHEDULE
}

model AiSchedule {
  id                String         @id @default(cuid())
  name              String
  cron              String
  timezone          String         @default("Asia/Jakarta")
  topics            String[]
  category          String?
  instructions      String?
  mode              AiScheduleMode @default(DRAFT)
  publishDelayHours Int            @default(0)
  enabled           Boolean        @default(true)
  nextRunAt         DateTime?
  lastRunAt         DateTime?
  runs              AiRun[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([enabled, nextRunAt])
}

enum AiRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

model AiRun {
  id           String      @id @default(cuid())
  trigger      String
  topic        String?
  scheduleId   String?
  schedule     AiSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  status       AiRunStatus @default(RUNNING)
  postId       String?
  providerName String?
  model        String?
  steps        Json?
  summary      String?
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  error        String?
  createdAt    DateTime    @default(now())
  finishedAt   DateTime?

  @@index([createdAt])
  @@index([scheduleId])
}

model AiChatSession {
  id        String   @id @default(cuid())
  title     String
  adminId   String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminId, updatedAt])
}

enum SupportStatus {
  AI
  WAITING_HUMAN
  HUMAN
  CLOSED
}

enum SupportRole {
  USER
  AI
  ADMIN
  SYSTEM
}

/// Public website chat (logged-in visitors). AI answers from website knowledge until handed off to an admin.
model SupportConversation {
  id            String           @id @default(cuid())
  userId        String
  userName      String?
  userEmail     String?
  status        SupportStatus    @default(AI)
  handoffReason String?
  adminUnread   Int              @default(0)
  lastMessageAt DateTime         @default(now())
  messages      SupportMessage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, lastMessageAt])
  @@index([userId, updatedAt])
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           SupportRole
  content        String
  authorName     String?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}
