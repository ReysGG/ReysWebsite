# Copy this file to .env.docker, then fill the values. Do NOT commit .env.docker.

APP_PORT=3000
NEXT_PUBLIC_SITE_URL=https://buildwithreys.com

# Database: self-hosted Postgres from docker-compose (service "db"). A fresh/empty database is
# bootstrapped automatically on first start (scripts/db-bootstrap.mjs). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://reys:change-me@db:5432/reys
DIRECT_URL=postgresql://reys:change-me@db:5432/reys
DATABASE_POOL_MAX=5

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional, only if used by your app/features
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# Optional: Supabase Storage (S3-compatible). Leave empty to store uploads on the server disk
# (volume "uploads", served at /uploads/...). Get from: Supabase Dashboard → Storage → S3 Access Keys
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Bucket name — create a public bucket in Supabase Storage first
SUPABASE_S3_BUCKET=

# AI Studio (admin-only LLM writer + chatbot)
# REQUIRED. Encrypts LLM provider API keys stored in the database. Generate: openssl rand -base64 32
# Do NOT change it after saving providers (existing keys can no longer be decrypted).
AI_ENCRYPTION_KEY=
# REQUIRED for schedules. Protects /api/cron/ai-tick (auto-articles + scheduled publishing).
# Generate: openssl rand -hex 32. The `cron` service in docker-compose.yml calls the endpoint every 5 minutes.
CRON_SECRET=
# Optional: stock photo search for AI articles (https://unsplash.com/developers, https://www.pexels.com/api/)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
